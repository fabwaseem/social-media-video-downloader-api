{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Keep the incremental build-info inside outDir. Nest's `deleteOutDir`
    // wipes dist on every start; if the build-info survived outside it, tsc
    // would consider the emit up to date and write no dist/main.js at all.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
